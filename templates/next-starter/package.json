{
  "name": "iimp-next-app",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "version": "node scripts/sync-app-version.mjs",
    "version:check": "node scripts/sync-app-version.mjs --check",
    "release:patch": "npm version patch",
    "release:minor": "npm version minor",
    "release:major": "npm version major",
    "check": "npm run format:check && npm run version:check && npm run typecheck && npm run lint && npm run test && npm run build",
    "setup": "iimp-adopt --skills-only",
    "skills:recommend": "iimp-adopt --skills-only --recommend-skills"
  },
  "dependencies": {
    "next": "16.3.8",
    "official-uikit-iimp": "0.8.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nrivera-iimp/adopt": "0.1.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.19.15",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "jsdom": "30.1.1",
    "postcss": "8.5.28",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "packageManager": "npm@11.17.0"
}
