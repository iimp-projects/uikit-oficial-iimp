{
  "name": "official-uikit-iimp",
  "version": "0.4.0",
  "description": "Design System / UI Kit oficial de Eventos IIMP",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./eslint": {
      "types": "./eslint/index.d.ts",
      "default": "./eslint/index.js"
    },
    "./package.json": "./package.json",
    "./theme.css": "./dist/theme.css"
  },
  "files": [
    "dist",
    "eslint",
    "!eslint/**/*.test.ts"
  ],
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "npm run build:js && npm run build:css",
    "build:js": "tsup",
    "build:css": "tailwindcss -i ./src/styles/globals.css -o ./dist/style.css --minify && cp src/styles/theme.css dist/theme.css",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:consumer": "node scripts/consumer-test.mjs"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@phosphor-icons/react": "^2.1.10",
    "@remixicon/react": "^4.9.0",
    "@shadcn/react": "^0.3.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react-day-picker": "^10.0.1",
    "react-resizable-panels": "^4.13.3",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@playwright/test": "^1.63.0",
    "@storybook/addon-a11y": "^9",
    "@storybook/addon-docs": "^9",
    "@storybook/react-vite": "^9",
    "@tailwindcss/cli": "^4",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^5",
    "eslint-plugin-storybook": "^9",
    "jsdom": "^30.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "storybook": "^9",
    "tailwindcss": "^4",
    "tsup": "^8",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vite": "^6",
    "vitest": "^3.2.7",
    "vitest-axe": "^0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iimp-projects/uikit-oficial-iimp.git"
  }
}
